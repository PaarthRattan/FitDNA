# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# Without the Supabase values the app still runs, on demo data and signed out.
# NEXT_PUBLIC_ values are baked in by `next build`: set them before building, and rebuild after changing them.

# Local: run `npm run db:start`; the URL is http://127.0.0.1:54321 and `npx supabase status` shows the key.
# Hosted: Supabase → Project Settings → API. Use the publishable key (sb_publishable_...), not the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. The site's public URL, used in sign-in emails. Defaults to the request's origin.
# Add <this URL>/auth/callback to Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Server-only secret key (sb_secret_...), used to delete accounts ("Delete my data").
# Never prefix it with NEXT_PUBLIC_, and never use it for anything a user could do themselves.
SUPABASE_SECRET_KEY=

# Listing import (M4a). Firecrawl fetches pasted listing pages: 1 credit per page.
# Off unless FIRECRAWL_ENABLED is exactly "true" and a key is set; with it off, imports
# fall back to typing the numbers in by hand. Server-only: never prefix with NEXT_PUBLIC_.
# Turn on zero data retention in the Firecrawl dashboard if your plan offers it.
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
# Optional: a self-hosted Firecrawl. Defaults to https://api.firecrawl.dev.
FIRECRAWL_API_URL=

# AI reading of listing text (M4b), with DeepSeek. Used only when the regex pass misses
# measurements. Off unless AI_ENABLED is exactly "true" and a key is set. Only listing
# text is ever sent (names and contact details removed), never anything about a user.
# Listing photos are read too (up to four, when the text has no measurements or the user
# asks). Server-only. Optional: AI_MODEL_TEXT and AI_MODEL_VISION (default deepseek-flash);
# DEEPSEEK_API_URL points at a local stub for tests. `npm run eval` reads these too.
DEEPSEEK_API_KEY=
AI_ENABLED=false

# Photo scans (M6): the scan service in services/scan. Off unless SCAN_ENABLED is exactly
# "true", SCAN_API_URL is set (https, or http://127.0.0.1 for the local stub) and
# SCAN_API_SECRET is at least 32 characters (the same value as the service's). Server-only.
# Local development: run `uv run python stub_server.py --port 8787` in services/scan with
# the same SCAN_API_SECRET, and set SCAN_API_URL=http://127.0.0.1:8787.
# NOT FOR REAL USERS until the validation study and the launch gates in the M6 plan pass.
SCAN_ENABLED=false
SCAN_API_URL=
SCAN_API_SECRET=
# Modal's proxy auth token (Modal-Key / Modal-Secret); leave empty for the stub.
SCAN_PROXY_TOKEN_ID=
SCAN_PROXY_TOKEN_SECRET=
# Comma-separated user ids allowed to scan while testing. Must be empty at launch.
SCAN_ALLOWLIST_USER_IDS=
# `next dev` only: there are no region headers locally, and an unknown region is blocked
# (Illinois fails closed). Set e.g. CA-QC to stand in for them. Ignored in production.
SCAN_DEV_REGION=
